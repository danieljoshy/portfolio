:root {
    --bg-color: #050505;
    --text-primary: #ffffff;
    --text-secondary: #a0a0a0;
}

/* RESET */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Outfit', sans-serif;
    background: var(--bg-color);
    color: var(--text-primary);
    height: 100vh;
    overflow: hidden;
}

/* ================= BACKGROUND ================= */
.background-layer {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
}

.bg-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    filter: brightness(0.5) contrast(1.1);
}

.background-layer::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center,
            rgba(0, 0, 0, 0.3),
            rgba(0, 0, 0, 0.85));
    z-index: 1;
    pointer-events: none;
}

.about-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    background-image: url('hands.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.5;
    z-index: -1;
    filter: grayscale(100%) contrast(1.2) brightness(0.8);
    mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);
    pointer-events: none;
}

/* ================= NAVBAR ================= */
.top-header {
    position: fixed;
    top: 20px;
    left: 0;
    width: 100%;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 20px;
}

.nav-container {
    width: 100%;
    max-width: 1200px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 30px;
    background: rgba(20, 20, 20, 0.4);
    backdrop-filter: blur(12px);
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.section-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 200;
    font-size: 5rem;
    color: #ffffff;
    letter-spacing: 5px;
    text-transform: uppercase;
    position: relative;
    padding: 15px 60px;
    /* Equal padding top/bottom */
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 100px;
    /* Fully rounded pill shape like reference */
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    margin-bottom: 30px;

    /* Flexbox for absolute centering */
    display: inline-flex;
    justify-content: center;
    align-items: center;
    line-height: 1;
    /* Reset line-height to avoid offset */
}

.logo {
    font-weight: 600;
    letter-spacing: 1px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 6px 16px;
    border-radius: 20px;
}

.main-nav ul {
    display: flex;
    gap: 30px;
    list-style: none;
    align-items: center;
}

.main-nav a {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    position: relative;
    transition: 0.3s;
}

.main-nav a:hover,
.main-nav a.active {
    color: #fff;
}

.main-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 1px;
    background: #fff;
    transition: width 0.3s;
}

.main-nav a:hover::after,
.main-nav a.active::after {
    width: 100%;
}

.btn-contact {
    padding: 8px 18px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
}

/* ================= HERO ================= */
.content-layer {
    position: relative;
    z-index: 10;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.profile-card {
    width: 320px;
    height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.image-container {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 30px;
    box-shadow:
        0 20px 50px rgba(0, 0, 0, 0.6),
        inset 0 0 0 2px rgba(255, 255, 255, 0.1);
    animation: breathe 5s ease-in-out infinite;
}

@keyframes breathe {

    0%,
    100% {
        box-shadow:
            0 20px 50px rgba(0, 0, 0, 0.6),
            inset 0 0 0 2px rgba(255, 255, 255, 0.1);
    }

    50% {
        box-shadow:
            0 20px 65px rgba(0, 0, 0, 0.8),
            inset 0 0 0 2px rgba(255, 255, 255, 0.2);
    }
}

.image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

h1 {
    font-size: 2.2rem;
    font-weight: 300;
    margin-bottom: 10px;
}

h1 span {
    font-weight: 600;
    background: linear-gradient(180deg, #fff, #bbb);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.subtitle {
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-secondary);
}

/* ================= RESPONSIVE ================= */
@media (max-width: 768px) {
    .image-container {
        width: 180px;
        height: 180px;
    }

    h1 {
        font-size: 1.8rem;
    }
}

/* ================= ABOUT PAGE ================= */
.about-section {
    position: relative;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 20px;
    z-index: 10;
}

.content-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 800px;
    width: 100%;
}

.glass-bio-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    padding: 40px;
    margin-top: 0px;
    /* Reduced since title has margin */
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.glass-bio-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
    background: rgba(255, 255, 255, 0.05);
}

.glass-bio-card p {
    font-size: 1.2rem;
    line-height: 1.8;
    color: #d0d0d0;
    font-weight: 300;
    max-width: 700px;
    margin: 0 auto;
}